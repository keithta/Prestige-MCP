# =============================================================================
# Campaign application environment
# Copy to .env and fill in.  NEVER commit a filled-in copy.
# Every variable here must also be documented in docs/ENVIRONMENT.md
# (enforced by `npm run test` -> docs drift check).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Database (authoritative source of truth) ------------------------------
# Local dev/testing: postgresql://campaign:campaign@127.0.0.1:55432/campaign_test
# Supabase:          postgresql://postgres.<ref>:<password>@<host>:6543/postgres
DATABASE_URL=postgresql://campaign:campaign@127.0.0.1:55432/campaign_test

# --- Supabase (admin UI auth + client access) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS. Must never appear in a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Microsoft Graph / Entra ID --------------------------------------------
# Application (app-only) permissions: Mail.Send, admin-consented.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Use EITHER a client secret (cloud dev) OR a certificate (Windows production).
GRAPH_CLIENT_SECRET=
GRAPH_CLIENT_CERTIFICATE_PATH=
GRAPH_CLIENT_CERTIFICATE_PASSWORD=
GRAPH_CLIENT_CERTIFICATE_THUMBPRINT=
# Override only for tests against the mock Graph server. Refused when NODE_ENV=production.
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_AUTHORITY_HOST=https://login.microsoftonline.com
# draft_then_send (default, recoverable) | send_mail (one call, faster, not disambiguable)
GRAPH_SEND_STRATEGY=draft_then_send
GRAPH_TIMEOUT_MS=30000

# --- Worker ----------------------------------------------------------------
WORKER_ID=worker-local-1
WORKER_PORT=3001
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=120
WORKER_MAX_CONCURRENCY=1
# Bearer token required by POST /tick. Generate: openssl rand -hex 32
WORKER_TICK_TOKEN=

# --- Web -------------------------------------------------------------------
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
# HMAC key for unsubscribe links. Generate: openssl rand -hex 32
UNSUBSCRIBE_HMAC_SECRET=

# --- Compliance ------------------------------------------------------------
# Required in every campaign footer (CAN-SPAM). Approval is blocked without it.
COMPLIANCE_POSTAL_ADDRESS=
COMPLIANCE_ORG_NAME=
